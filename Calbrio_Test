  <h1>Pendo Multi-Badge Test Page</h1>
  <p class="subtitle">Three disabled "Select Assignee" fields. The goal: Pendo fires a badge-like indicator on all three, not just the first.</p>

  <div class="instructions">
    <strong>Setup instructions</strong>
    1. Install your Pendo snippet in the <code>&lt;head&gt;</code> below the title tag.<br>
    2. In your Pendo sub, create a guide with a <strong>Custom HTML</strong> step.<br>
    3. Set the guide to activate on this page (URL match).<br>
    4. Paste the test JS into the Custom HTML step's <code>onLoad</code> handler.<br>
    5. Publish and reload — all three fields below should show a pink badge.<br><br>
    Selector used: <code>[data-disabled="true"]</code>
  </div>

  <!-- Field 1 -->
  <div class="field-row">
    <span class="field-label">Task 1</span>
    <span class="field-input" data-disabled="true" data-test-id="assignee-1">Select Assignee</span>
  </div>

  <!-- Field 2 -->
  <div class="field-row">
    <span class="field-label">Task 2</span>
    <span class="field-input" data-disabled="true" data-test-id="assignee-2">Select Assignee</span>
  </div>

  <!-- Field 3 -->
  <div class="field-row">
    <span class="field-label">Task 3</span>
    <span class="field-input" data-disabled="true" data-test-id="assignee-3">Select Assignee</span>
  </div>

  <!-- Active field for contrast -->
  <div class="field-row">
    <span class="field-label">Task 4</span>
    <span class="field-input" style="color:#222; background:#fff; cursor:default;">Jane Smith</span>
  </div>

  <!--
    PASTE YOUR PENDO SNIPPET HERE
    e.g. <script>(function(apiKey){ ... })(YOUR_API_KEY);</script>
  -->

  <!--
    CUSTOM HTML STEP JS TO TEST (paste into Pendo guide onLoad):

    document.querySelectorAll('[data-disabled="true"]').forEach(function(el) {
      var badge = document.createElement('span');
      badge.style.cssText = 'display:inline-block;margin-left:6px;background:#FF3366;color:#fff;border-radius:50%;width:16px;height:16px;text-align:center;font-size:11px;line-height:16px;cursor:pointer;vertical-align:middle;';
      badge.innerText = '?';
      badge.title = 'This assignee has been deactivated or merged.';
      el.parentNode.insertBefore(badge, el.nextSibling);
    });
  -->

